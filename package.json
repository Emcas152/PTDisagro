{
  "name": "ptdisagro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de Promociones y Registro de Clientes para Evento Anual - Disagro",
  "scripts": {
    "build": "pnpm --filter @ptdisagro/contracts build && pnpm --filter @ptdisagro/api build && pnpm --filter @ptdisagro/web build",
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter @ptdisagro/web dev",
    "dev:api": "pnpm --filter @ptdisagro/api dev",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @ptdisagro/contracts test && pnpm --filter @ptdisagro/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.30.3"
}
